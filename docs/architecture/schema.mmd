erDiagram
    USERS ||--o| BORROWERS : has
    GENRES ||--o{ BOOKS : classifies
    BOOKS ||--o{ BOOK_AUTHORS : has
    AUTHORS ||--o{ BOOK_AUTHORS : writes
    BOOKS ||--o{ LOANS : appears_in
    BORROWERS ||--o{ LOANS : borrows

    USERS {
        int id PK
        string email
        string name
        timestamp created_at
    }

    BORROWERS {
        int id PK
        int user_id FK
        string library_card_number
        timestamp created_at
    }

    GENRES {
        int id PK
        string name
    }

    AUTHORS {
        int id PK
        string name
    }

    BOOKS {
        int id PK
        int genre_id FK
        string isbn
        string title
        int available_copies
    }

    BOOK_AUTHORS {
        int id PK
        int book_id FK
        int author_id FK
    }

    LOANS {
        int id PK
        int book_id FK
        int borrower_id FK
        timestamp borrowed_at
        timestamp due_at
        timestamp returned_at
    }
